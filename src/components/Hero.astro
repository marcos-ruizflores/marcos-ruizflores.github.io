---
import { content, type Lang } from '../i18n/content';
import { Image } from 'astro:assets';
import { links } from '../data/profile';
import photo from '../assets/photo.jpg';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang].hero;
---

<section class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] items-center gap-12 px-4 pb-20 pt-14 sm:px-6 md:grid-cols-[minmax(0,1fr)_auto] md:pt-24">
  <div>
    <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-muted">
      <span class="pulse-dot size-2 rounded-full bg-emerald-500"></span>
      {t.badge}
    </span>

    <h1 class="mt-6 text-6xl font-extrabold leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl">
      <span class="block">Marcos</span>
      <span class="block text-accent">Ruiz-Flores</span>
    </h1>

    <p class="mt-6 font-mono text-sm text-muted">
      {t.role}<span class="mx-2 text-subtle">·</span>{t.location}
    </p>

    <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted text-pretty">{t.intro}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="#projects"
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-90">
        {t.primary}
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 5v14m0 0-6-6m6 6 6-6"></path>
        </svg>
      </a>
      <a
        href={links.cv}
        download
        class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-3 text-sm font-semibold transition-colors hover:border-accent hover:text-accent">
        {t.cv}
      </a>
    </div>
  </div>

  <div class="relative mx-auto size-56 sm:size-72">
    <div class="absolute -inset-3 rounded-full bg-[radial-gradient(circle,var(--accent-soft),transparent_70%)]" aria-hidden="true"></div>
    {/* The source photo is already cut into a circle on grey, so scale it a touch to hide the corners */}
    <div class="relative size-full overflow-hidden rounded-full border border-line">
      <Image
        src={photo}
        alt={t.photoAlt}
        widths={[224, 288, 448, 522]}
        sizes="(min-width: 640px) 288px, 224px"
        loading="eager"
        fetchpriority="high"
        class="size-full scale-[1.04] object-cover"
      />
    </div>
  </div>
</section>
