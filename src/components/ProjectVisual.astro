---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../i18n/content';
import toriiSearch from '../assets/projects/torii-search.png';
import toriiHistory from '../assets/projects/torii-history.png';
import criptoPanel from '../assets/projects/cripto-panel.png';
import criptoAllocation from '../assets/projects/cripto-allocation.png';
import tfgCover from '../assets/projects/tfg-cover.png';
import tfgGrover from '../assets/projects/tfg-grover.png';

interface Props {
  project: Project;
  flip?: boolean;
}

const { project, flip = false } = Astro.props;

const shots: Record<Project['visual'], [ImageMetadata, ImageMetadata]> = {
  torii: [toriiSearch, toriiHistory],
  cripto: [criptoPanel, criptoAllocation],
  thesis: [tfgCover, tfgGrover],
};

const [main, detail] = shots[project.visual];
const [mainAlt, detailAlt] = project.alt ?? ['', ''];
---

<div class:list={['tilt relative pb-[16%]', flip && 'tilt-flip']}>
  <figure class="tilt-main overflow-hidden rounded-xl border border-line bg-surface shadow-xl shadow-black/10 sm:w-[90%]">
    <div class="flex gap-1.5 border-b border-line px-3 py-2.5" aria-hidden="true">
      <span class="size-2 rounded-full bg-line"></span>
      <span class="size-2 rounded-full bg-line"></span>
      <span class="size-2 rounded-full bg-line"></span>
    </div>
    <Image src={main} alt={mainAlt} widths={[560, 900, 1200]} sizes="(min-width: 768px) 500px, 100vw" class="block h-auto w-full" />
  </figure>
  <figure class="tilt-detail absolute bottom-0 right-0 w-[55%] overflow-hidden rounded-lg border border-line shadow-2xl shadow-black/30">
    <Image src={detail} alt={detailAlt} widths={[400, 800]} sizes="(min-width: 768px) 300px, 55vw" class="block h-auto w-full" />
  </figure>
</div>
