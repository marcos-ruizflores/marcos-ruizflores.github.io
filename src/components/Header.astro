---
import { content, type Lang } from '../i18n/content';
import { links } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const home = lang === 'en' ? '/' : '/es/';
const sections = ['about', 'experience', 'projects', 'skills', 'education', 'contact'] as const;
---

<header class="sticky top-0 z-40 border-b border-transparent backdrop-blur-md transition-colors" data-header>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="flex items-center gap-2.5 font-semibold tracking-tight">
      <span class="grid size-8 place-items-center rounded-lg bg-accent text-xs font-bold text-bg">MR</span>
      <span class="hidden sm:inline">Marcos Ruiz-Flores</span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-sm text-muted">
        {
          sections.map((id) => (
            <li>
              <a href={`#${id}`} data-nav={id} class="rounded-md px-3 py-2 transition-colors hover:text-ink">
                {t.nav[id]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="flex rounded-lg border border-line p-0.5 font-mono text-[11px]" role="group" aria-label={t.langLabel}>
        <a
          href="/"
          hreflang="en"
          aria-current={lang === 'en' ? 'true' : undefined}
          class:list={['rounded-md px-2 py-1', lang === 'en' ? 'bg-ink text-bg' : 'text-muted hover:text-ink']}>EN</a
        >
        <a
          href="/es/"
          hreflang="es"
          aria-current={lang === 'es' ? 'true' : undefined}
          class:list={['rounded-md px-2 py-1', lang === 'es' ? 'bg-ink text-bg' : 'text-muted hover:text-ink']}>ES</a
        >
      </div>

      <button
        type="button"
        data-theme-toggle
        data-label-light={t.theme.toLight}
        data-label-dark={t.theme.toDark}
        aria-label={t.theme.toDark}
        class="grid size-9 place-items-center rounded-lg border border-line text-muted transition-colors hover:text-ink">
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"></path>
        </svg>
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <a
        href={links.cv}
        download
        class="hidden items-center gap-1.5 rounded-lg bg-accent px-3.5 py-2 text-sm font-semibold text-bg transition-opacity hover:opacity-90 sm:inline-flex">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"></path>
        </svg>
        CV
      </a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  const syncLabel = () => {
    if (!toggle) return;
    const dark = root.dataset.theme === 'dark';
    toggle.setAttribute('aria-label', (dark ? toggle.dataset.labelLight : toggle.dataset.labelDark) ?? '');
  };

  syncLabel();
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncLabel();
  });

  // Border under the header once the page scrolls
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.classList.toggle('border-line', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Highlight the section currently on screen
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        navLinks.forEach((a) => a.classList.toggle('text-ink', a.dataset.nav === entry.target.id));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  navLinks.forEach((a) => {
    const section = document.getElementById(a.dataset.nav ?? '');
    if (section) observer.observe(section);
  });
</script>
