---
import { content, type Lang } from '../i18n/content';
import SectionHeading from './SectionHeading.astro';
import TechChip from './TechChip.astro';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang].skills;
---

<section id="skills" class="border-y border-line bg-surface/40 py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <SectionHeading tag={t.tag} title={t.title} />

    {/* Rows stacked like layers, joined by a thin line on the left */}
    <ol class="relative space-y-3 before:absolute before:bottom-6 before:left-[2.5rem] sm:before:left-[2.75rem] before:top-6 before:w-px before:bg-line">
      {
        t.groups.map((group) => (
          <li
            class="skill-row group relative grid gap-4 rounded-2xl border border-line bg-surface p-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/10 sm:grid-cols-[200px_minmax(0,1fr)] sm:items-center sm:p-5"
            data-reveal>
            <div class="flex items-center gap-3">
              <span class="relative grid h-8 w-12 shrink-0 place-items-center rounded-lg border border-line bg-surface-2 font-mono text-[10px] font-medium text-accent transition-colors duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-bg">
                {group.code}
              </span>
              <h3 class="font-semibold">{group.name}</h3>
            </div>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <TechChip name={item} />
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
