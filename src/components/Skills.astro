---
import { content, type Lang } from '../i18n/content';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang].skills;
---

<section id="skills" class="border-y border-line bg-surface/40 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading tag={t.tag} title={t.title} />

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.groups.map((group) => (
          <div class="rounded-2xl border border-line bg-surface p-6">
            <h3 class="font-mono text-xs uppercase tracking-wider text-accent">{group.name}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-md bg-surface-2 px-2.5 py-1 text-sm text-muted">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
