---
import { iconFor } from '../data/icons';

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
const icon = iconFor(name);
---

<li
  class:list={[
    'inline-flex items-center gap-1.5 rounded-md border border-line bg-surface px-2.5 py-1 text-xs font-medium text-muted transition-colors hover:border-accent/50 hover:text-ink',
    className,
  ]}>
  {
    icon && (
      <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill={icon.color ?? 'currentColor'} aria-hidden="true">
        <path d={icon.path} />
      </svg>
    )
  }
  {name}
</li>
