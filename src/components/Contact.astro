---
import { content, type Lang } from '../i18n/content';
import { links } from '../data/profile';
import { siGithub } from 'simple-icons';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang].contact;
---

<section id="contact" class="border-t border-line bg-surface/40 py-24">
  <div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
    <span class="inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">{t.tag}</span>
    <h2 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">{t.title}</h2>
    <p class="mt-5 text-lg leading-relaxed text-muted text-pretty">{t.text}</p>

    <a
      href={`mailto:${links.email}`}
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 font-semibold text-bg transition-opacity hover:opacity-90">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
      </svg>
      {t.email}
    </a>
    <p class="mt-3 font-mono text-xs text-subtle">{links.email}</p>

    <div class="mt-8 flex justify-center gap-3">
      <a
        href={links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="grid size-11 place-items-center rounded-lg border border-line text-muted transition-colors hover:border-accent hover:text-accent">
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.6h.06c.53-1 1.84-2.05 3.78-2.05 4.04 0 4.79 2.66 4.79 6.12V21h-4v-4.98c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.91 1.3-1.91 2.63V21h-4V9.75Z"></path>
        </svg>
      </a>
      <a
        href={links.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="grid size-11 place-items-center rounded-lg border border-line text-muted transition-colors hover:border-accent hover:text-accent">
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siGithub.path}></path></svg>
      </a>
    </div>
  </div>
</section>
