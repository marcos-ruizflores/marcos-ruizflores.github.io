---
import { content, type Lang } from '../i18n/content';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang].education;
---

<section id="education" class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
  <SectionHeading tag={t.tag} title={t.title} />

  <div
    class="group relative flex flex-col gap-4 overflow-hidden rounded-2xl border border-line bg-surface p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-xl hover:shadow-accent/10 sm:flex-row sm:items-center sm:gap-6 sm:p-8"
    data-reveal>
    <span
      class="grid size-14 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-accent to-accent/60 text-bg shadow-lg shadow-accent/30 transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-105">
      <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m2 9 10-5 10 5-10 5L2 9Z"></path>
        <path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"></path>
      </svg>
    </span>
    <div class="flex-1">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="font-mono text-xs text-accent">{t.period}</p>
        <span class="inline-flex items-center gap-1 rounded-full bg-surface-2 px-2.5 py-0.5 text-xs text-muted">
          <svg class="size-3 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
            <path d="m5 12 5 5L20 7"></path>
          </svg>
          {t.status}
        </span>
      </div>
      <h3 class="mt-1 text-lg font-bold">{t.degree}</h3>
      <p class="text-muted">{t.school}</p>
      <p class="mt-2 text-sm text-subtle">{t.thesis}</p>
    </div>
    {/* Accent bar that fills the bottom edge on hover */}
    <span class="absolute bottom-0 left-0 h-0.5 w-1/4 bg-accent transition-all duration-500 group-hover:w-full" aria-hidden="true"></span>
  </div>
</section>
