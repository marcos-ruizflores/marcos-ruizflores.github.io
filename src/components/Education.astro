---
import { content, type Lang } from '../i18n/content';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang].education;
---

<section id="education" class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
  <SectionHeading tag={t.tag} title={t.title} />

  <div class="flex flex-col gap-4 rounded-2xl border border-line bg-surface p-6 sm:flex-row sm:items-center sm:gap-6 sm:p-8">
    <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent">
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m2 9 10-5 10 5-10 5L2 9Z"></path>
        <path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"></path>
      </svg>
    </span>
    <div class="flex-1">
      <h3 class="text-lg font-bold">{t.degree}</h3>
      <p class="text-muted">{t.school}</p>
      <p class="mt-2 text-sm text-subtle">{t.thesis}</p>
    </div>
    <p class="font-mono text-xs text-subtle">{t.period}</p>
  </div>
</section>
