---
interface Props {
  tag: string;
  title: string;
}

const { tag, title } = Astro.props;
---

<div class="mb-12 text-center">
  <span class="inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">{tag}</span>
  <h2 class="mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl">{title}</h2>
</div>
